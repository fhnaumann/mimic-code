    {
      "forEach": "code.coding.where(system='http://mimic.mit.edu/fhir/mimic/CodeSystem/mimic-chartevents-d-items' and code='220045')",
      "column": [
        { "path": "code", "name": "item_code" },
        { "path": "system", "name": "item_system" }
      ]
    }
  ]
}
