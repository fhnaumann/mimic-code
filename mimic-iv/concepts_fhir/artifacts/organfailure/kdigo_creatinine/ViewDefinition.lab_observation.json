        },
        {
          "path": "(value).ofType(Quantity).value",
          "name": "quantity_value"
        },
        {
          "path": "(value).ofType(Quantity).comparator",
          "name": "quantity_comparator"
        },
        {
          "path": "(value).ofType(string)",
          "name": "value_string"
        },
        {
          "path": "(effective).ofType(dateTime)",
          "name": "effective_datetime"
        }
      ]
    },
    {
      "forEach": "code.coding.where(system='http://mimic.mit.edu/fhir/mimic/CodeSystem/mimic-d-labitems' and code='50912')",
      "column": [
        {
          "path": "code",
          "name": "code"
        },
        {
          "path": "system",
          "name": "system"
        }
      ]
    }
  ],
  "id": "kdigo-creatinine-lab-observation",
