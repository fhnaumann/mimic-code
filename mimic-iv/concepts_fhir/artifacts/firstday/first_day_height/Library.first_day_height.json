  "content": [
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/sql-text",
          "valueString": "WITH icu AS (\n    SELECT\n        CAST(p.subject_id_str AS INTEGER) AS subject_id,\n        CAST(e.stay_id_str AS INTEGER) AS stay_id,\n        TRY_CAST(e.period_start AS TIMESTAMP_NTZ) AS period_start,\n        e.patient_key AS patient_key,\n        e.icu_encounter_key AS icu_encounter_key\n    FROM icu_encounter e\n    LEFT JOIN patient p\n        ON e.patient_key = p.patient_key\n    WHERE e.stay_id_str IS NOT NULL\n), aggregated AS (\n    SELECT\n        i.subject_id,\n        i.stay_id,\n        i.patient_key,\n        i.icu_encounter_key,\n        ROUND(AVG(h.height), 2) AS height\n    FROM icu i\n    LEFT JOIN height h\n        ON i.icu_encounter_key = h.icu_encounter_key\n        AND h.charttime >= i.period_start - INTERVAL 6 HOURS\n        AND h.charttime <= i.period_start + INTERVAL 1 DAY\n    GROUP BY\n        i.subject_id,\n        i.stay_id,\n        i.patient_key,\n        i.icu_encounter_key\n)\nSELECT\n    CAST(a.height AS DECIMAL(38,2)) AS height,\n    a.patient_key,\n    a.icu_encounter_key\nFROM aggregated a\n;\n"
        }
      ],
      "contentType": "application/sql;dialect=spark-sql",
      "data": ""
    }
  ]
