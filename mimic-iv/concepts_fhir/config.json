{
  "format_version": 2,
  "execution": {
    "one_concept_per_goal": true,
    "parallel_subagents_within_goal": false,
    "parallel_goals": "human_composed_waves",
    "demo_gate": "shape_only",
    "demo_zero_rows": "unsure",
    "max_full_runs_per_concept": 10,
    "full_row_count_gated": false,
    "full_verdicts": ["match", "mismatch", "review"],
    "full_review_tiers": ["gap_shaped", "contested"],
    "full_divergence_classes_defined_in": "src/mimic_utils/compare_port_results.py",
    "divergence_floor": null,
    "judge_decides": "review"
  },
  "source": {
    "dataset": "MIMIC-IV",
    "version": "2.2",
    "engine": "duckdb",
    "demo_oracle_env": "MIMIC_DUCKDB_PATH",
    "demo_oracle_default": "/Users/nau025/warehouses/mimic4-demo.db",
    "full_oracle_path": "/scratch3/nau025/oracle/mimic4-full.db",
    "full_oracle_manifest": "mimic-iv/concepts_fhir/oracle/oracle_manifest.full.json",
    "derived_schema": "mimiciv_derived",
    "read_only": true
  },
  "target": {
    "dataset": "MIMIC-on-FHIR",
    "version": "2.1",
    "engine": "pathling-embedded-spark",
    "demo_warehouse_env": "MIMIC_FHIR_WAREHOUSE",
    "demo_warehouse_default": "/Users/nau025/warehouses/mimic-iv-demo/delta",
    "full_warehouse_path": "/scratch3/nau025/mimic-on-fhir-delta/spark_warehouse",
    "full_oracle_env": "MIMIC_FULL_ORACLE",
    "candidate_format": "parquet"
  }
}
