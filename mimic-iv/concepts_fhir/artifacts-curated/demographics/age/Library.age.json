  "content": [
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/sql-text",
          "valueString": "SELECT\n    TRY_CAST(e.period_start AS TIMESTAMP) AS admittime,\n    CAST(NULL AS SMALLINT) AS anchor_age,\n    CAST(NULL AS SMALLINT) AS anchor_year,\n    CAST(\n        YEAR(TRY_CAST(e.period_start AS TIMESTAMP_NTZ))\n        - YEAR(TRY_CAST(p.birth_date AS DATE))\n        AS BIGINT\n    ) AS age,\n    p.patient_key,\n    e.encounter_key\nFROM encounter e\nINNER JOIN patient p\n    ON e.patient_key = p.patient_key\nWHERE e.hadm_id_str IS NOT NULL\n;\n"
        }
      ],
      "contentType": "application/sql;dialect=spark-sql",
      "data": ""
    }
  ]
