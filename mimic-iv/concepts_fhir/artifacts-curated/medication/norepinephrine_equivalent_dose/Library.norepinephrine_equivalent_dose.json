{
  "resourceType": "Library",
  "id": "norepinephrine-equivalent-dose",
  "url": "https://fhnaumann.masters/pathling/Library/norepinephrine_equivalent_dose",
  "version": "3",
  "name": "norepinephrine_equivalent_dose",
  "status": "active",
  "type": {
    "coding": [
      {
        "system": "https://sql-on-fhir.org/ig/CodeSystem/LibraryTypesCodes",
        "code": "sql-view"
      }
    ]
  },
  "relatedArtifact": [
    {
      "type": "depends-on",
      "label": "encounter_icu",
      "resource": "https://fhnaumann.masters/pathling/ViewDefinition/shared-icu_encounter"
    },
    {
      "type": "depends-on",
      "label": "vasoactive_agent",
      "resource": "https://fhnaumann.masters/pathling/Library/vasoactive_agent"
    }
  ],
  "content": [
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/sql-text",
          "valueString": "SELECT\n    CAST(v.starttime AS TIMESTAMP_NTZ) AS starttime,\n    CAST(v.endtime AS TIMESTAMP_NTZ) AS endtime,\n    CAST(\n        ROUND(\n            CAST(\n                COALESCE(v.norepinephrine, 0)\n                + COALESCE(v.epinephrine, 0)\n                + COALESCE(v.phenylephrine / 10, 0)\n                + COALESCE(v.dopamine / 100, 0)\n                + COALESCE(v.vasopressin * 2.5 / 60, 0)\n                AS DECIMAL(38,9)\n            ),\n            4\n        ) AS DECIMAL(38,4)\n    ) AS norepinephrine_equivalent_dose,\n    v.icu_encounter_key,\n    v.patient_key\nFROM vasoactive_agent AS v\nJOIN encounter_icu AS e\n    ON v.icu_encounter_key = e.icu_encounter_key\n   AND e.stay_system = 'http://mimic.mit.edu/fhir/mimic/identifier/encounter-icu'\nWHERE v.norepinephrine IS NOT NULL\n    OR v.epinephrine IS NOT NULL\n    OR v.phenylephrine IS NOT NULL\n    OR v.dopamine IS NOT NULL\n    OR v.vasopressin IS NOT NULL;\n"
        }
      ],
      "contentType": "application/sql;dialect=spark-sql",
      "data": ""
    }
  ]
}
