{
  "resourceType": "ViewDefinition",
  "status": "active",
  "url": "https://fhnaumann.masters/pathling/ViewDefinition/meld-icu_encounter",
  "name": "icu_encounter",
  "resource": "Encounter",
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "icu_encounter_key"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_key"
        },
        {
          "path": "partOf.getReferenceKey(Encounter)",
          "name": "hospital_encounter_key"
        },
        {
          "path": "period.start",
          "name": "intime"
        },
        {
          "path": "period.end",
          "name": "outtime"
        }
      ]
    },
    {
      "forEach": "identifier.where(system='http://mimic.mit.edu/fhir/mimic/identifier/encounter-icu')",
      "column": [
        {
          "path": "value",
          "name": "stay_id_str"
        },
        {
          "path": "system",
          "name": "stay_id_system"
        }
      ]
    }
  ],
  "id": "meld-icu-encounter",
  "version": "2"
}
